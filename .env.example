# PigIDE — environment template.
# Copy to `.env` (in repo root or next to the binary) and fill in values.
#
# Loader looks in this order, first hit wins:
#   1. $PIGIDE_ENV_FILE
#   2. ./.env                       (cwd, e.g. when running from repo)
#   3. <exe_dir>/.env               (next to the pigide binary)
#   4. <exe_dir>/../.env            (e.g. dist/bin/pigide → dist/.env)
#   5. ~/.config/pigide/.env        (XDG user config)
#
# Lines already in the environment are NOT overridden.

# --- Architect (LLM backend) -------------------------------------------------
# Anthropic API key — used by the Claude orchestrator.
ANTHROPIC_API_KEY=

# --- Watcher (Gemini, requires --features watcher at build time) -------------
# Google AI Studio key for gemma-3-4b-it. Without this the watcher
# self-disables (one warning line in logs) and the rest of the app works.
GEMINI_API_KEY=

# Per-agent rate-limit (requests/minute). Default 10.
# PIGIDE_WATCHER_RPM=10

# Optional model override.
# PIGIDE_WATCHER_MODEL=gemma-3-4b-it

# --- Runtime overrides --------------------------------------------------------
# Force CPU-only Whisper at runtime (skip GPU init even if compiled with gpu-*).
# PIGIDE_WHISPER_CPU=1

# Logging filter (tracing-subscriber).
# RUST_LOG=pigide=debug,info
